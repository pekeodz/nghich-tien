rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Quản trị viên = có document /admins/{uid}. Tạo tay trong Firebase Console,
    // không ai tạo được từ game.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /characters/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Lần đầu tạo nhân vật: không được tự gắn cờ admin.
      allow create: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.get('adminRev', 0) == 0 &&
        !request.resource.data.keys().hasAny(['banned', 'banReason', 'adminNote', 'adminAt']) &&
        request.resource.data.updatedAt == request.time
      );

      // Người chơi lưu tiến trình: không bị khoá, đang giữ đúng phiên bản admin mới nhất,
      // và không đụng vào các trường của admin.
      allow update: if isAdmin() || (
        isOwner(uid) &&
        resource.data.get('banned', false) != true &&
        request.resource.data.get('adminRev', 0) == resource.data.get('adminRev', 0) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['banned', 'banReason', 'adminNote', 'adminAt']) &&
        request.resource.data.updatedAt == request.time
      );

      allow delete: if isAdmin();

      // Sao lưu mỗi ngày: người chơi chỉ được TẠO, không sửa/xoá.
      match /backups/{day} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow update, delete: if isAdmin();
      }
    }

    // Sổ ghi các lần admin sửa nhân vật.
    match /adminLog/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
